      "handler": "agentHandler.ListGrants",
      "auth": "bearer",
      "min_role": "viewer",
      "display_token": true,
      "note": "What a host may ask for. Readable by any authenticated user \u2014 a grant is a statement of policy and holds no secret \u2014 and written by an operator, because it decides what the organisation's CA will sign on a machine's say-so.",
      "source_line": 364
    },
    {
      "method": "POST",
      "path": "/api/v1/agent-grants",
      "section": "Agents",
      "handler": "agentHandler.CreateGrant",
