      "handler": "agentHandler.ClaimDeployments",
      "auth": "agent-signature",
      "min_role": null,
      "display_token": false,
      "note": "The inversion that makes an agent a deployment target. Every other target is deployed to by a core worker opening a connection; a host behind two firewalls claims the job itself, off the same queue, with the same lease and the same retry curve.",
      "source_line": 144
    },
    {
      "method": "POST",
      "path": "/api/v1/agent/deployments/result",
      "section": "The agent API",
      "handler": "agentHandler.ReportDeploymentResult",
      "auth": "agent-signature",
      "min_role": null,
      "display_token": false,
      "note": "",
      "source_line": 145
    },
    {
