# Frontend configuration. Copy to .env.local and edit.
#
# Everything here is compiled into the browser bundle and is therefore public.
# Never put a service role key, a JWT secret, or CERTPILOT_KEK in this file.

# Supabase is optional. Leave both unset to run against a core with
# auth.allow_anonymous enabled, which is the default for local development.
#
# The anon/publishable key is designed to be public — it is the URL that scopes
# it to your project, and Row Level Security that constrains it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CertPilot Core API. Defaults to the Vite dev proxy, so it is normally left
# unset in development.
# VITE_API_BASE_URL=http://localhost:8080
